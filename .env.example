# Copy to .env and fill in. Never commit .env.
# Use URL-safe passwords (letters/digits), they end up in DATABASE_URL.
# Defaults for Linux (Ubuntu Server with Docker Engine, docs/server-setup.md,
# step 47). scripts/up.sh fills in the secrets and RENDER_GID.

# PostgreSQL (used by docker-compose for the db container)
POSTGRES_USER=cinevault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cinevault

# Only for running the API outside Docker (pnpm dev:api). docker-compose
# builds its own DATABASE_URL from the POSTGRES_* values above.
DATABASE_URL=postgresql://cinevault:change-me@localhost:5432/cinevault
API_PORT=3000
# The API port is only published on the N100 itself (127.0.0.1), for the scripts;
# browsers and apps go through Caddy. 0.0.0.0 opens it to the home network.
# API_BIND=127.0.0.1
# Web interface (Caddy), open http://<N100>:8765 in a browser.
WEB_PORT=8765

# Access from outside (docs/server-setup.md, step 20): Caddy serves this domain
# over HTTPS with a Let's Encrypt certificate. It needs ports 80 and 443
# forwarded in the router to the N100 (check with scripts/public-access.sh).
# Empty: only the home network and Tailscale.
PUBLIC_DOMAIN=
# Only if another program needs 80/443 on the N100; Let's Encrypt still
# reaches the router on 80/443, so forward those to these ports.
# HTTP_PORT=80
# HTTPS_PORT=443
LOG_LEVEL=info

# Host folder that contains the library folders (Movies, Series, Anime),
# mounted read-only into the api and transcoder containers (as /media).
# (Windows: D:/Media, with forward slashes.)
MEDIA_ROOT=/mnt/media
# Scratch space for the transcoder's HLS segments (a host folder, mounted as
# /transcode). Prefer an SSD. scripts/up.sh makes it.
TRANSCODE_TMP=/srv/cinevault-data/transcode

# Transcoder (phase 4): the transcoder container, with the Intel GPU
# (/dev/dri). TRANSCODER_TOKEN is a shared secret between the API and the
# transcoder; scripts/up.sh creates it.
TRANSCODER_TOKEN=
# Video transcodes at the same time. Keep it low while Plex shares the GPU.
TRANSCODER_MAX_TRANSCODES=2
# The group that may use the GPU's render node /dev/dri/renderD128: the number
# of the render group on this machine (getent group render). scripts/up.sh
# fills it in.
RENDER_GID=
# qsv: the GPU (falls back to the CPU when its self test fails); none: CPU only.
# TRANSCODER_HWACCEL=qsv
# Where the API finds the transcoder; only change it if it runs elsewhere.
# (On Windows it was http://host.docker.internal:8766: scripts/up.sh changes that.)
# TRANSCODER_URL=http://transcoder:8766

# Chromecast: the address where a Chromecast reaches CineVault. Best over https:
# Google's receiver runs on https and may refuse an HLS stream over http (mixed
# content), so https://<PUBLIC_DOMAIN> if the router loops the public address
# back into the home network (scripts/public-access.sh tells). Else the LAN
# address of the N100 with WEB_PORT, e.g. http://192.168.0.110:8765. Without it,
# casting uses the address the phone uses (a Tailscale address 100.x a
# Chromecast can't reach). Beheer -> Gezondheid -> Chromecast checks it.
CAST_BASE_URL=

# Metadata. Without a TMDB key, movies stay unmatched and shows use TVmaze only.
TMDB_API_KEY=
# Language of titles and descriptions (TMDB), e.g. nl-NL or en-US.
# Missing Dutch texts fall back to English. Searching always uses English names.
METADATA_LANGUAGE=nl-NL
# Scan all libraries every time the API starts (true/false).
SCAN_ON_STARTUP=false
# Look for new and changed files this often (minutes), so new downloads show up
# under "Nieuw" on the start page. Unchanged files are not read again. 0 = off.
SCAN_INTERVAL_MINUTES=60
# Skip Intro for anime: openings and endings from AniSkip (api.aniskip.com),
# before CineVault reads the audio itself. false = only chapters and audio.
ANISKIP=true
# Theme music on a show's page: the theme Plex uses (tvthemes.plexapp.com, by
# TVDB id; no Plex server needed), fetched once and kept in the cache. false = off.
PLEX_THEMES=true
# "Ontdekken": anime rows (this season, trending, coming, popular, films) and
# anime in searches (also by romaji or Japanese title) from AniList
# (graphql.anilist.co). false = TMDB's anime rows, as before.
ANILIST=true
# Theme music for anime Plex has none for: the first opening on AnimeThemes
# (animethemes.moe). false turns it off.
ANIME_THEMES=true
# Theme music for shows Plex and AnimeThemes have none for: ThemerrDB's YouTube
# link (by TMDB id), downloaded with yt-dlp (kept up to date in the cache).
# false = off.
THEMERRDB=true
# Picture subtitles (PGS, from Blu-rays) read as text, so every player can show
# them. In the background while nobody watches. false = off.
SUBTITLE_OCR=true

# Requests ("Verzoeken"): titles someone asks for are added to Radarr and
# Sonarr. The API key is under Settings -> General in each. The addresses are
# as the API container sees them: host.docker.internal is this server (Radarr
# and Sonarr in Docker with published ports, or installed directly).
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=

# Notifications: quiet hours (23:00-08:00) and "airs today" use this time zone.
NOTIFY_TIMEZONE=Europe/Amsterdam

# Subtitles (phase 6): searching and downloading on OpenSubtitles.
OPENSUBTITLES_API_KEY=
# Optional free OpenSubtitles account: a higher daily download limit.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Accounts (phase 5). scripts/up.sh fills both in when empty (64 hex characters each).
# JWT_SECRET signs the logins: changing it logs everyone out.
JWT_SECRET=
# For scripts (scan.sh, verify-setup.sh): `Authorization: Bearer <API_TOKEN>`, as admin.
API_TOKEN=
# Sonarr and Radarr call CineVault after a download, so it scans right away
# (scripts/arr-webhook.sh prints the address). It can only start a scan.
WEBHOOK_TOKEN=

# Database backups (scripts/backup.sh): where, and how many to keep.
# Empty: ~/CineVault-backups. On the N100 n100-server sets /mnt/media/backups/cinevault.
BACKUP_DIR=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Android builds on the server (scripts/build-apk.sh): the folder with the
# signing key (Documents\CineVault-android on Windows). Empty: ~/CineVault-android.
ANDROID_KEY_DIR=
