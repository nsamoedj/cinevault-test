+package expo.modules.video
+
+import androidx.annotation.OptIn
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.session.MediaSession
+import androidx.media3.session.SessionResult
+
+/**
+ * CineVault patch (patches/expo-video@58.0.11.patch): in a car, video only
+ * plays while it is parked. The media sessions of this module refuse play from
+ * outside the app (steering wheel, the car's media controls, the Assistant,
+ * the system's media controls) while the car drives.
+ *
+ * The state comes from CineVault's own module (nl.cinevault.media.DrivingGate,
+ * written by CinevaultMediaModule, which reads the car's UX restrictions).
+ * Through reflection, because this library doesn't depend on that module.
+ * Without that class (another app, a phone without the module) video is
+ * always allowed.
+ */
+internal object VideoGate {
+  private const val HOLDER = "nl.cinevault.media.DrivingGate"
+
+  private val field by lazy {
+    runCatching { Class.forName(HOLDER).getField("videoAllowed") }.getOrNull()
+  }
+
+  fun allowed(): Boolean = runCatching { field?.getBoolean(null) ?: true }.getOrDefault(true)
+
+  /**
+   * For MediaSession.Callback.onPlayerCommandRequest: refuses play/pause from
+   * a controller while video isn't allowed, and pauses the player. Null: no
+   * opinion, the callback goes on as usual.
+   */
+  @OptIn(UnstableApi::class)
+  fun refuse(session: MediaSession, playerCommand: Int): Int? {
+    if (playerCommand != Player.COMMAND_PLAY_PAUSE || allowed()) return null
+    session.player.pause()
+    return SessionResult.RESULT_ERROR_INVALID_STATE
+  }
+}
+
+/** The callback of the basic media session (before the playback service runs). */
+@OptIn(UnstableApi::class)
+internal class GatedMediaSessionCallback : MediaSession.Callback {
+  override fun onPlayerCommandRequest(
+    session: MediaSession,
+    controller: MediaSession.ControllerInfo,
+    playerCommand: Int
+  ): Int = VideoGate.refuse(session, playerCommand)
+    ?: super.onPlayerCommandRequest(session, controller, playerCommand)
+}
